{
  "name": "attest-link",
  "version": "0.6.1",
  "type": "module",
  "types": "./src/browser/attest-fetch.d.ts",
  "exports": {
    "types": "./src/browser/attest-fetch.d.ts",
    "default": "./src/browser/attest-fetch.js"
  },
  "description": "Tunnel TCP/HTTP to Nitro Enclaves/Sandboxes",
  "repository": {
    "type": "git",
    "url": "git://github.com/rhodey/AttestLink.git"
  },
  "homepage": "https://github.com/rhodey/AttestLink",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js test/browser/*.test.js"
  },
  "dependencies": {
    "libsodium": "0.8.4",
    "libsodium-wrappers": "0.8.4",
    "minimist": "1.2.8",
    "semver": "7.8.6"
  },
  "license": "MIT",
  "bin": {
    "attest-link": "src/bin.js"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "wasm/attest-link.js",
    "bin/darwin-arm64/attest-link-rust",
    "bin/linux-arm64/attest-link-rust",
    "bin/linux-x64/attest-link-rust",
    "licenses/*.txt"
  ],
  "keywords": [
    "attest",
    "attestation",
    "aws",
    "nitro",
    "enclave",
    "sandbox",
    "tunnel"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
